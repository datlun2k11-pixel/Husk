<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Lets StikDebug attach to us as a debugger. Without this there is no JIT. -->
	<key>get-task-allow</key>
	<true/>
	<!-- Only honoured on TrollStore/jailbroken devices; harmless otherwise, and it
	     lets the same build skip the StikDebug dance where it IS honoured. -->
	<key>dynamic-codesigning</key>
	<true/>
	<!-- An Android guest needs real RAM on top of the host app's own footprint.
	     Proven to work on sideloaded builds in AetherPS4-iOS. -->
	<key>com.apple.developer.kernel.increased-memory-limit</key>
	<true/>
	<!-- Mappings past ~4 GB need this. The guest RAM block plus the JIT's dual
	     RW/RX mapping exceed that, and without it the large mapping is simply
	     refused. Husk does not depend on it being honoured: the address space is
	     probed at startup and the guest is sized to whatever actually maps. -->
	<key>com.apple.developer.kernel.extended-virtual-addressing</key>
	<true/>
	<!-- How a LAN game finds its opponents: the host announces itself by broadcast
	     or to a multicast group, and the clients listen. iOS refuses both directions
	     without this entitlement, which Apple grants per App ID, so a signer that
	     can carry it (TrollStore, a jailbroken device, or a certificate that injects
	     entitlements) makes LAN discovery work, and one that cannot drops it and
	     leaves unicast, which is what joining by address has always used. -->
	<key>com.apple.developer.networking.multicast</key>
	<true/>
</dict>
</plist>
